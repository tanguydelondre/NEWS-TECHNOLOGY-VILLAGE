# WhatsApp au format international sans + ni espaces
WHATSAPP_NUMBER=229014222197
PORT=10000

# Facultatif : ajouter une base PostgreSQL Render pour persister les commandes.
DATABASE_URL=

# MongoDB Atlas: URL privée de la base, à configurer dans Render (ne pas publier cette valeur)
MONGODB_URI=
MONGODB_DB=ntv_boutique

# Identifiants de l'espace /admin : choisissez un mot de passe long et unique
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_LONG_ET_UNIQUE

# Secret privé de signature des sessions utilisateurs (32 caractères minimum recommandés)
AUTH_SECRET=GENERER_UN_SECRET_ALEATOIRE_LONG_ET_UNIQUE

# Facultatif mais recommandé pour fiabiliser les appels audio/vidéo WebRTC en production
# Utiliser un service TURN avec identifiants temporaires si possible
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Adresse professionnelle affichée par la plateforme (créer cette boîte chez votre hébergeur mail)
PROFESSIONAL_EMAIL=contact@ntvmall.com

SUPPORT_EMAIL=support@ntvmall.com

# Cloudinary : utiliser soit CLOUDINARY_URL au format cloudinary://API_KEY:API_SECRET@CLOUD_NAME,
# soit les trois variables séparées ci-dessous. Ne jamais publier les secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
